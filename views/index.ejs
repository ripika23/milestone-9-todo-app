<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Todo Manager</title>

    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <div class="container">

        <h1>Todo Manager</h1>

        <!-- Add Todo -->
        <section class="add-todo">
            <h2>Add New Todo</h2>

            <form action="/todos" method="POST" id="todoForm">

                <input
                    type="hidden"
                    name="_csrf"
                    value="<%= csrfToken %>"
                >

                <div class="form-group">
                    <label for="title">Todo</label>

                    <input
                        type="text"
                        id="title"
                        name="title"
                        placeholder="Enter todo title"
                        required
                    >
                </div>

                <div class="form-group">
                    <label for="dueDate">Due Date</label>

                    <input
                        type="date"
                        id="dueDate"
                        name="dueDate"
                        required
                    >
                </div>

                <button type="submit">
                    Add Todo
                </button>

            </form>
        </section>


        <!-- Overdue -->
        <section class="todo-section">

            <h2>
                Overdue (<%= overdue.length %>)
            </h2>

            <%- include("todos", {
                todos: overdue,
                csrfToken: csrfToken
            }) %>

        </section>


        <!-- Due Today -->
        <section class="todo-section">

            <h2>
                Due Today (<%= dueToday.length %>)
            </h2>

            <%- include("todos", {
                todos: dueToday,
                csrfToken: csrfToken
            }) %>

        </section>


        <!-- Due Later -->
        <section class="todo-section">

            <h2>
                Due Later (<%= dueLater.length %>)
            </h2>

            <%- include("todos", {
                todos: dueLater,
                csrfToken: csrfToken
            }) %>

        </section>


        <!-- Completed Items -->
        <section class="todo-section completed-section">

            <h2>
                Completed Items (<%= completed.length %>)
            </h2>

            <%- include("todos", {
                todos: completed,
                csrfToken: csrfToken
            }) %>

        </section>

    </div>

    <script src="/app.js"></script>

</body>

</html>