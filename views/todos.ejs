<% if (todos.length === 0) { %>

    <p class="empty-message">No todos in this section.</p>

<% } else { %>

    <div class="todo-list">

        <% todos.forEach(todo => { %>

            <div class="todo-card <%= todo.completed ? 'completed' : '' %>">

                <div class="todo-info">

                    <h3>
                        <%= todo.title %>
                    </h3>

                    <p>
                        Due:
                        <%= todo.dueDate %>
                    </p>

                </div>

                <div class="todo-actions">

                    <% if (todo.completed) { %>

                        <button
                            type="button"
                            class="complete-btn incomplete-btn"
                            data-id="<%= todo.id %>"
                            data-completed="false"
                            data-csrf="<%= csrfToken %>"
                        >
                            Mark Incomplete
                        </button>

                    <% } else { %>

                        <button
                            type="button"
                            class="complete-btn"
                            data-id="<%= todo.id %>"
                            data-completed="true"
                            data-csrf="<%= csrfToken %>"
                        >
                            Mark Completed
                        </button>

                    <% } %>


                    <form
                        action="/todos/<%= todo.id %>?_method=DELETE"
                        method="POST"
                        class="delete-form"
                    >

                        <input
                            type="hidden"
                            name="_csrf"
                            value="<%= csrfToken %>"
                        >

                        <button
                            type="submit"
                            class="delete-btn"
                        >
                            Delete
                        </button>

                    </form>

                </div>

            </div>

        <% }) %>

    </div>

<% } %>